# Copie ce fichier en ".env" et remplis les vraies valeurs.
# En local : DATABASE_URL pointe vers ta base PostgreSQL locale ou celle de Railway.
# Sur Railway : ces variables sont à renseigner dans l'onglet "Variables" du service.

DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/gestion_commerciale"

# Clé secrète pour signer les sessions (JWT). Génère une valeur aléatoire longue et unique.
# Astuce pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# Port d'écoute du serveur (Railway le définit automatiquement en production, inutile d'y toucher là-bas)
PORT=4000

# Origine autorisée pour les appels depuis le frontend (à ajuster une fois le frontend déployé)
FRONTEND_URL="http://localhost:5173"
